@page "{id:int}"
@model SoporteLab.Pages.Tickets.EditarModel
@{
    ViewData["Title"] = "Editar Ticket";
}

<h1>Editar Ticket</h1>

<form method="post" class="mt-4">
    <div class="mb-3">
        <label asp-for="Entrada.Titulo" class="form-label">Título</label>
        <input asp-for="Entrada.Titulo" class="form-control" />
        <span asp-validation-for="Entrada.Titulo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Entrada.Descripcion" class="form-label">Descripción</label>
        <textarea asp-for="Entrada.Descripcion" class="form-control" rows="3"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Entrada.Estado" class="form-label">Estado</label>
        <select asp-for="Entrada.Estado" class="form-select">
            <option>Abierto</option>
            <option>En proceso</option>
            <option>Cerrado</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Entrada.TecnicoId" class="form-label">Técnico asignado</label>
        <select asp-for="Entrada.TecnicoId" asp-items="Model.Tecnicos" class="form-select">
            <option value="">-- Sin asignar --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-secondary" asp-page="/Tablero">Cancelar</a>
</form>