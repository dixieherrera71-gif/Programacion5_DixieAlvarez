@page "{id:int}"
@model SoporteLab.Pages.Tickets.EliminarModel
@{
    ViewData["Title"] = "Eliminar Ticket";
}

<h1>Eliminar Ticket</h1>

<div class="alert alert-warning mt-4" role="alert">
    ¿Segura que quieres eliminar este ticket? No se puede deshacer.
</div>

<dl class="row mt-4">
    <dt class="col-sm-3">Título</dt>
    <dd class="col-sm-9">@Model.Ticket.Titulo</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.Ticket.Estado</dd>

    <dt class="col-sm-3">Técnico</dt>
    <dd class="col-sm-9">@(Model.Ticket.Tecnico?.Nombre ?? "Sin asignar")</dd>
</dl>

<form method="post" class="mt-4">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a class="btn btn-secondary" asp-page="/Tablero">Cancelar</a>
</form>
