@page
@model SoporteLab.Pages.TableroModel
@{
    ViewData["Title"] = "Tablero";
}

<h1>Tablero de control</h1>

<h2>Tickets</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Título</th>
            <th>Estado</th>
            <th>Técnico</th>
            <th>Fecha</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model.Tickets)
        {
            <tr>
                <td>@t.Id</td>
                <td>@t.Titulo</td>
                <td>@t.Estado</td>
                <td>@(t.Tecnico?.Nombre ?? "Sin asignar")</td>
                <td>@t.FechaCreacion.ToString("dd/MM/yyyy")</td>
                <td>
                    <a class="btn btn-sm btn-warning" asp-page="/Tickets/Editar" asp-route-id="@t.Id">Editar</a>
                    <a class="btn btn-sm btn-danger" asp-page="/Tickets/Eliminar" asp-route-id="@t.Id">Borrar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p><a class="btn btn-primary" asp-page="/Tickets/Crear">Crear nuevo ticket</a></p>

<hr />

<h2>Técnicos</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Teléfono</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tec in Model.Tecnicos)
        {
            <tr>
                <td>@tec.Id</td>
                <td>@tec.Nombre</td>
                <td>@tec.Correo</td>
                <td>@tec.Telefono</td>
                <td>
                    <a class="btn btn-sm btn-warning" asp-page="/Tecnicos/Editar" asp-route-id="@tec.Id">Editar</a>
                    <a class="btn btn-sm btn-danger" asp-page="/Tecnicos/Eliminar" asp-route-id="@tec.Id">Borrar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p><a class="btn btn-primary" asp-page="/Tecnicos/Crear">Crear nuevo técnico</a></p>
<p><a class="btn btn-secondary" asp-page="/Reportes/Reporte">Ver Reporte</a></p>