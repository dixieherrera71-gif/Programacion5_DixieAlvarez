@page "{id:int}"
@model SoporteLab.Pages.Tecnicos.EliminarModel
@{
    ViewData["Title"] = "Eliminar Técnico";
}

<h1>Eliminar Técnico</h1>

<div class="alert alert-warning mt-4" role="alert">
    ¿Estás seguro que deseas eliminar a este técnico? Esta acción no se puede deshacer.
</div>

<dl class="row mt-4">
    <dt class="col-sm-3">Nombre completo</dt>
    <dd class="col-sm-9">@Model.Tecnico.Nombre</dd>

    <dt class="col-sm-3">Correo electrónico</dt>
    <dd class="col-sm-9">@Model.Tecnico.Correo</dd>

    <dt class="col-sm-3">Teléfono</dt>
    <dd class="col-sm-9">@Model.Tecnico.Telefono</dd>
</dl>

<form method="post" class="mt-4">
    <button type="submit" class="btn btn-danger">Eliminar definitivamente</button>
    <a class="btn btn-secondary" asp-page="/Tablero">Cancelar</a>
</form>