@page
@model SoporteLab.Pages.Tecnicos.EliminarModel

@{
    ViewData["Title"] = "Eliminar tecnico";
}

<div class="container mt-4" style="max-width: 640px;">

    <h1 class="mb-3 text-danger">Eliminar tecnico</h1>

    <p>Esta accion no se puede deshacer. Confirma que deseas eliminar:</p>

    <dl class="row">

        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Entrada?.Nombre</dd>

        <dt class="col-sm-3">Especialidad</dt>
        <dd class="col-sm-9">@Model.Entrada?.Especialidad</dd>

        <dt class="col-sm-3">Correo</dt>
        <dd class="col-sm-9">@Model.Entrada?.Correo</dd>

    </dl>

    <form method="post">

        <input type="hidden" name="id" value="@Model.Entrada?.Id" />

        <button type="submit" class="btn btn-danger">
            Eliminar
        </button>

        <a asp-page="/Tablero" class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>