@page "{id:int}"
@model SoporteLab.Pages.Tecnicos.EditarModel
@{
    ViewData["Title"] = "Editar Técnico";
}

<h1>Editar Técnico</h1>

<form method="post" class="mt-4">
    <div class="mb-3">
        <label asp-for="Entrada.Nombre" class="form-label">Nombre completo</label>
        <input asp-for="Entrada.Nombre" class="form-control" />
        <span asp-validation-for="Entrada.Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Entrada.Correo" class="form-label">Correo electrónico</label>
        <input asp-for="Entrada.Correo" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Entrada.Telefono" class="form-label">Teléfono</label>
        <input asp-for="Entrada.Telefono" class="form-control" />
        <span asp-validation-for="Entrada.Telefono" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-secondary" asp-page="/Tablero">Cancelar</a>
</form>