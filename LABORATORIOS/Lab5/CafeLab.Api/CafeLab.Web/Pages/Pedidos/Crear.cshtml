@page
@model CafeLab.Web.Pages.Pedidos.CrearModel
@{
    ViewData["Title"] = "Nuevo pedido";
}

<h1 class="mb-3">Nuevo pedido</h1>

@if (Model.Mensaje is not null)
{
    <div class="alert @(Model.Exito ? "alert-success" : "alert-danger")">
        @Model.Mensaje
    </div>
}

<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Entrada.Cliente" class="form-label">Su nombre</label>
        <input asp-for="Entrada.Cliente" class="form-control" />
        <span asp-validation-for="Entrada.Cliente" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Entrada.ProductoId" class="form-label">Producto</label>
        <select asp-for="Entrada.ProductoId" class="form-select">
            <option value="0">-- Seleccione --</option>
            @foreach (var p in Model.Productos)
            {
                <option value="@p.Id">
                    @p.Nombre (@p.Precio.ToString("N2"))
                </option>
            }
        </select>
        <span asp-validation-for="Entrada.ProductoId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Entrada.Cantidad" class="form-label">Cantidad</label>
        <input asp-for="Entrada.Cantidad" type="number" min="1" max="20"
               class="form-control" />
        <span asp-validation-for="Entrada.Cantidad" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Enviar pedido</button>
    <a asp-page="/Menu" class="btn btn-link">Volver al menu</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}