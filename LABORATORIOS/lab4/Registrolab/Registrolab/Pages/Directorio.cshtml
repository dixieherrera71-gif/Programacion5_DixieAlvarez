@page
@model RegistroLab.Pages.DirectorioModel
@using RegistroLab.Pages
@using RegistroLab.Models
@{
    ViewData["Title"] = "Directorio de Matrícula";
}

<div class="container mt-4">
    <h2>📋 Directorio del Curso</h2>

    <p class="text-muted fs-5">@Model.ResumenCurso</p>

    @if (!Model.Inscritos.Any())
    {
        <div class="alert alert-info mt-3">
            Aún no hay personas matriculadas.
            <a asp-page="Registro" class="alert-link">Ir al formulario de inscripción</a>
        </div>
    }
    else
    {
        <table class="table table-striped table-hover mt-4">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Clasificación</th>
                    <th>Monto a pagar</th>
                    <th>Presentación</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int numeroFila = 1;
                    var curso = RegistroLab.Pages.RegistroModel.CursoPrincipal;
                }

                @foreach (var persona in Model.Inscritos)
                {
                    <tr>
                        <td>@(numeroFila++)</td>
                        <td>@RegistroLab.Pages.DirectorioModel.Clasificar(persona)</td>
                        <td>@persona.CalcularMatricula(curso).ToString("C")</td>
                        <td><em>@persona.Presentarse()</em></td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.ListaEspera.Any())
    {
        <h4 class="mt-5 text-warning">⏳ Lista de Espera</h4>
        <ul class="list-group mt-2">
            @foreach (var persona in Model.ListaEspera)
            {
                <li class="list-group-item">@persona.NombreFormateado()</li>
            }
        </ul>
    }

    <div class="mt-4">
        <a asp-page="Registro" class="btn btn-primary">Matricular a otra persona</a>
    </div>
</div>