@page
@model RegistroLab.Pages.RegistroModel
@{
    ViewData["Title"] = "Matrícula";
}

<div class="container mt-4">
    <h2>Formulario de Matrícula</h2>
    <form method="post">
        <div class="mb-3">
            <label asp-for="Datos.Tipo" class="form-label">Tipo de matrícula</label>
            <select asp-for="Datos.Tipo" class="form-select">
                <option value="regular">Estudiante Regular</option>
                <option value="becado">Estudiante Becado</option>
                <option value="docente">Docente Oyente</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Datos.Nombre" class="form-label">Nombre completo</label>
            <input asp-for="Datos.Nombre" class="form-control" />
            <span asp-validation-for="Datos.Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Datos.Correo" class="form-label">Correo electrónico</label>
            <input asp-for="Datos.Correo" class="form-control" />
            <span asp-validation-for="Datos.Correo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Datos.Edad" class="form-label">Edad</label>
            <input asp-for="Datos.Edad" class="form-control" type="number" />
            <span asp-validation-for="Datos.Edad" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Datos.Carne" class="form-label">Carné</label>
            <input asp-for="Datos.Carne" class="form-control" placeholder="2024-0001" />
            <span asp-validation-for="Datos.Carne" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Datos.PorcentajeBeca" class="form-label">Porcentaje de beca</label>
            <input asp-for="Datos.PorcentajeBeca" class="form-control" type="number" />
        </div>

        <div class="mb-3">
            <label asp-for="Datos.Especialidad" class="form-label">Especialidad</label>
            <input asp-for="Datos.Especialidad" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Enviar matrícula</button>
    </form>
</div>